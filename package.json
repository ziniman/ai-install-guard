{
  "name": "ai-install-guard",
  "version": "0.8.8",
  "description": "A Claude Code mod that runs in the background: every /plugin install and marketplace you add, yours or Claude's, is scanned before it happens, without running any of it, and nothing installs until you approve.",
  "scripts": {
    "build:fixtures": "node scripts/build-fixtures.js",
    "build:skill": "node scripts/build-skill.js",
    "benchmark": "node scripts/benchmark.js",
    "badge": "node scripts/build-skill.js && node scripts/badge.js",
    "sync:versions": "node scripts/sync-versions.js",
    "validate": "claude plugin validate --strict .",
    "typecheck": "tsc -p . && tsc -p cli",
    "test": "claude plugin test .",
    "test:skill": "node scripts/build-skill.js && node --test cli/scan.spec.mjs",
    "check": "npm run validate && npm run typecheck && npm test && npm run test:skill",
    "version": "node scripts/sync-versions.js && git add .claude-plugin/"
  },
  "keywords": [
    "claude",
    "claude-code",
    "security",
    "supply-chain",
    "static-analysis",
    "plugins",
    "skills",
    "mcp"
  ],
  "files": [
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "hooks/",
    "!hooks/**/*.test.ts",
    "!hooks/test-support/",
    "types/",
    "README.md",
    "docs/",
    "CONTRIBUTING.md",
    "assets/",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Boaz Ziniman <ziniman@gmail.com> (https://github.com/ziniman)",
  "homepage": "https://github.com/ziniman/ai-install-guard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziniman/ai-install-guard.git"
  },
  "bugs": "https://github.com/ziniman/ai-install-guard/issues",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
